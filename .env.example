# Copy this file to  .env  and fill in your own values.
# .env is gitignored - never commit it, never paste the URI into chat or a public repo.

# Your MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Put the DB password in place of <password>.
MONGODB_URI=mongodb+srv://USER:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional
MONGODB_DB=searchpeek
TTL_HOURS=6
